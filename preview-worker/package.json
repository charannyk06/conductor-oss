    "fastify": "^5.11.1",
    "puppeteer-core": "^25.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "fast-uri": "4.1.1",
    "find-my-way": "9.7.0"
  }
}
