WORKER_PORT=3099
# Generate with: openssl rand -hex 32
WORKER_API_KEY=replace-with-output-from-openssl-rand-hex-32
WORKER_SESSION_TIMEOUT_MS=600000
WORKER_MAX_SESSIONS=5
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
CLOUDFLARED_BIN=cloudflared
# Production images inject the source commit at build time.
CONDUCTOR_BUILD_SHA=unknown
# Leave Chrome's sandbox enabled unless the host provides an equivalent isolation boundary.
CONDUCTOR_PREVIEW_WORKER_DISABLE_SANDBOX=false
# CONDUCTOR_ALLOW_UNSAFE_PREVIEW_HOSTS=true
